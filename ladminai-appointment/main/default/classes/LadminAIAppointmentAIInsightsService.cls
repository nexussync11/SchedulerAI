public with sharing class LadminAIAppointmentAIInsightsService {
 @AuraEnabled(cacheable=false) public static InsightResult getInsights(){InsightResult out=new InsightResult();LadminAI_Appointment_Settings__mdt cfg=LadminAI_Appointment_Settings__mdt.getInstance('Default');if(cfg==null||cfg.LadminAI_Enable_AI_Insights__c!=true||String.isBlank(cfg.LadminAI_OpenAI_Named_Credential__c)){out.enabled=false;out.message='Connect OpenAI to enable AI Smart Insights.';return out;}try{LadminAIAppointmentAnalyticsService.Snapshot metrics=LadminAIAppointmentAnalyticsService.getSnapshot();Map<String,Object>input=new Map<String,Object>{'appointmentsThisMonth'=>metrics.appointmentsThisMonth,'cancellationRate'=>metrics.cancellationRate,'locationMetrics'=>metrics.locationMetrics};HttpRequest req=new HttpRequest();req.setEndpoint('callout:'+cfg.LadminAI_OpenAI_Named_Credential__c.trim()+'/v1/responses');req.setMethod('POST');req.setHeader('Content-Type','application/json');req.setTimeout(15000);req.setBody(JSON.serialize(new Map<String,Object>{'model'=>'gpt-5-mini','instructions'=>'Return three concise, read-only appointment operations insights. Do not infer personal information.','input'=>JSON.serialize(input)}));HttpResponse response=new Http().send(req);if(response.getStatusCode()<200||response.getStatusCode()>299)throw new CalloutException('AI service unavailable');Map<String,Object>body=(Map<String,Object>)JSON.deserializeUntyped(response.getBody());List<Object>outputs=(List<Object>)body.get('output');List<Object>content=outputs==null||outputs.isEmpty()?null:(List<Object>)((Map<String,Object>)outputs[0]).get('content');out.message=content==null||content.isEmpty()?'No insights were returned.':String.valueOf(((Map<String,Object>)content[0]).get('text'));out.enabled=true;}catch(Exception e){out.enabled=false;out.message='AI Smart Insights are temporarily unavailable. Appointment analytics and scheduling are unaffected.';}return out;}
 public class InsightResult{@AuraEnabled public Boolean enabled;@AuraEnabled public String message;}
}
