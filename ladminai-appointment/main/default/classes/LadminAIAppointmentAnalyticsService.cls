public with sharing class LadminAIAppointmentAnalyticsService {
 @AuraEnabled(cacheable=true) public static Snapshot getSnapshot(){Date first=Date.today().toStartOfMonth();Datetime fromUtc=LadminAIAppointmentBusinessTimeService.toUtc(first,Time.newInstance(0,0,0,0));Datetime toUtc=LadminAIAppointmentBusinessTimeService.toUtc(first.addMonths(1),Time.newInstance(0,0,0,0));List<ServiceAppointment__c> rows=[SELECT Id,Status__c,Scheduled_Start__c,Location__r.Name FROM ServiceAppointment__c WHERE Scheduled_Start__c>=:fromUtc AND Scheduled_Start__c<:toUtc WITH USER_MODE];Snapshot s=new Snapshot();s.appointmentsThisMonth=rows.size();s.cancelled=0;s.completed=0;s.locationMetrics=new Map<String,Integer>();for(ServiceAppointment__c r:rows){if(r.Status__c=='Cancelled'||r.Status__c=='Cancel')s.cancelled++;if(r.Status__c=='Completed')s.completed++;String n=r.Location__r?.Name;if(n!=null)s.locationMetrics.put(n,(s.locationMetrics.get(n)==null?0:s.locationMetrics.get(n))+1);}s.cancellationRate=rows.isEmpty()?0:Decimal.valueOf(s.cancelled*100).divide(rows.size(),1);return s;}
 public class Snapshot{@AuraEnabled public Integer appointmentsThisMonth;@AuraEnabled public Integer cancelled;@AuraEnabled public Integer completed;@AuraEnabled public Decimal cancellationRate;@AuraEnabled public Map<String,Integer> locationMetrics;}
}
