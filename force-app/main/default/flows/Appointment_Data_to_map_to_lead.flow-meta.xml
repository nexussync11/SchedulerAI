<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_This_Latest_Appointment</name>
        <label>Is This Latest Appointment?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Latest</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Appointment_DateTime__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Get_the_related_Lead.Appointment_Date_Time__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_the_related_Lead.Appointment_Date_Time__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_with_the_lastest_appt</targetReference>
            </connector>
            <label>Is Latest</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Appointment Data to map to lead {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Appointment Data to map to lead</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_the_related_Lead</name>
        <label>Get the related Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_This_Latest_Appointment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Lead__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>update_with_the_lastest_appt</name>
        <label>update with the lastest appt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_the_related_Lead.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Appointment_Booked__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Appointment_Date_Time__c</field>
            <value>
                <elementReference>$Record.Appointment_DateTime__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Appointment_Status__c</field>
            <value>
                <stringValue>Booked</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Appointment_Type__c</field>
            <value>
                <elementReference>$Record.Appointment_Type__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Appt_Closer__c</field>
            <value>
                <elementReference>$Record.Closer__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Confirmed_By_SDR__c</field>
            <value>
                <elementReference>$Record.Confirmed_By_SDR__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Confirmed__c</field>
            <value>
                <elementReference>$Record.Confirmed__c</elementReference>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_the_related_Lead</targetReference>
        </connector>
        <object>Appointment__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
